{
  "name": "jungle-distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor with PostgreSQL, TypeORM and SQS",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun --watch src/main.ts",
    "start:prod": "bun dist/main.js",
    "db:migrate": "bun src/migrate.ts up",
    "db:revert": "bun src/migrate.ts down",
    "test": "bun test",
    "test:integration": "bun scripts/test-integration.ts",
    "test:load": "bun scripts/test-load.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.900.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.2"
  }
}
